{
  "name": "fast-confluence-exporter",
  "description": "Export one or many Confluence pages into a single, good-looking PDF in seconds, entirely in your browser.",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/tajchert/FastConfluenceExporterExtension",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tajchert/FastConfluenceExporterExtension.git"
  },
  "bugs": {
    "url": "https://github.com/tajchert/FastConfluenceExporterExtension/issues"
  },
  "scripts": {
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "build": "wxt build",
    "build:e2e": "wxt build --mode e2e",
    "zip": "wxt zip",
    "zip:edge": "wxt zip -b edge",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:e2e && playwright test",
    "build:live": "wxt build --mode live",
    "test:live": "npm run build:live && playwright test -c playwright.live.config.ts",
    "screenshots": "npm run build:live && node scripts/store-screenshots.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "licenses": "node scripts/generate-licenses.mjs",
    "check:release": "node scripts/check-release.mjs && node scripts/generate-licenses.mjs --check",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@joplin/turndown-plugin-gfm": "1.0.68",
    "dompurify": "3.4.16",
    "fflate": "0.8.3",
    "pdf-lib": "1.17.1",
    "preact": "11.0.0",
    "turndown": "7.2.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "2.10.6",
    "@types/chrome": "0.3.4",
    "@types/node": "26.6.4",
    "@types/turndown": "5.0.6",
    "happy-dom": "20.14.5",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "wxt": "0.21.4"
  }
}
